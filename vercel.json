{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/index\\.php$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(css|js|img)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/(favicon\\.ico|robots\\.txt)$",
      "dest": "/public/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}